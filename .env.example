# Home Calendar Environment Configuration
# Copy this file to .env and fill in the appropriate values for your environment.
# DO NOT COMMIT .env TO VERSION CONTROL!
# DO NOT COMMIT .env.production OR .env.development TO VERSION CONTROL!

# ===== REQUIRED CONFIGURATION =====

# Application Environment
# Options: development, production
NODE_ENV=production

# Server Port
# The port the application will listen on
PORT=5500

# Weather API Configuration (REQUIRED)
# Get a free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_api_key_here

# Default Location for Weather (used if not specified per-user)
# Get coordinates from Google Maps or OpenWeatherMap
WEATHER_DEFAULT_LATITUDE=40.7128
WEATHER_DEFAULT_LONGITUDE=-74.0060

# ===== OPTIONAL CONFIGURATION =====

# Cache Duration (in milliseconds)
# Set to 0 to disable caching
# Development: 60000 (1 minute)
# Production: 600000 (10 minutes)
CACHE_DURATION_MS=600000

# Calendar Event Filtering
# Comma-separated list of event IDs to ignore/filter out
IGNORED_EVENT_IDS=

# API Base URL
# Useful if frontend is served from a different domain
API_BASE_URL=

# ===== OCTOPRINT CONFIGURATION (Optional) =====
# For 3D printer status monitoring via OctoPrint API
# Leave empty or unset to disable OctoPrint integration

# OctoPrint server URL
# Example: http://octopi.local or http://192.168.1.100:5000
OCTOPRINT_URL=

# OctoPrint API key
# Get from OctoPrint Settings → API
OCTOPRINT_API_KEY=

# How often to poll OctoPrint (in seconds)
# Default: 60 seconds
OCTOPRINT_REFRESH_INTERVAL_SECONDS=60

# ===== MQTT CONFIGURATION (Optional) =====
# For IoT devices like garage door sensors via MQTT broker
# Leave empty or unset to disable MQTT integration

# MQTT Broker Address
# Example: 192.168.1.100 or mqtt.example.com
MQTT_BROKER=

# MQTT Broker Username
MQTT_USERNAME=

# MQTT Broker Password
MQTT_PASSWORD=

# MQTT Topic for Garage Door State
# Example: home/garage/door/state
MQTT_GARAGE_DOOR_TOPIC=